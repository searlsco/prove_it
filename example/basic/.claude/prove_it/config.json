{
  "enabled": true,
  "sources": [
    "**/*.*",
    "replace/these/with/globs/of/your/source/and/test/files.*"
  ],
  "hooks": {
    "claude": {
      "SessionStart": [
        {
          "name": "session-briefing",
          "type": "script",
          "command": "$(prove_it prefix)/libexec/briefing"
        }
      ],
      "PreToolUse": [
        {
          "name": "lock-config",
          "type": "script",
          "command": "$(prove_it prefix)/libexec/guard-config",
          "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|mcp__.*",
          "quiet": true
        }
      ],
      "Stop": [
        {
          "name": "fast-tests",
          "type": "script",
          "command": "./script/test_fast"
        },

        {
          "name": "coverage-review",
          "type": "agent",
          "async": true,
          "prompt": "prove-coverage",
          "promptType": "skill",
          "model": "haiku",
          "when": {
            "linesChanged": 541
          },
          "ruleFile": ".claude/rules/testing.md"
        },
        {
          "name": "done-review",
          "type": "agent",
          "promptType": "skill",
          "prompt": "prove-done",
          "model": "opus",
          "ruleFile": ".claude/rules/testing.md",
          "when": {
            "signal": "done"
          }
        }
      ]
    },
    "git": {
      "pre-commit": [
        {
          "name": "full-tests",
          "type": "script",
          "command": "./script/test"
        }
      ]
    }
  }
}
